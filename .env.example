# Supabase Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# Your Supabase project URL
# You can find this in your Supabase project settings under API
SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anonymous/public key
# This key is safe to use in client-side code as it's protected by Row Level Security (RLS)
# You can find this in your Supabase project settings under API
SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service role key (ONLY for server-side/admin operations)
# NEVER use this in client-side code - it bypasses RLS policies
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: Debug mode flag
# DEBUG=false
